{
  "manifest_version": 3,
  "name": "Popup Guard",
  "version": "2.3.0",
  "description": "Stops any website from hijacking your clicks to open ad / malware tabs.",
  "permissions": ["storage", "tabs", "webNavigation", "scripting", "declarativeNetRequest"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png", "128": "icons/icon128.png" },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Popup Guard",
    "default_icon": { "16": "icons/icon16.png", "32": "icons/icon32.png", "48": "icons/icon48.png" }
  },
  "options_ui": { "page": "options.html", "open_in_tab": true }
}
